# Application Environment Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Persistent SQLite database on disk)
DATABASE_PATH=./data/ams_medical.db

# Localization & Business Standards
APP_TIMEZONE=Asia/Karachi
APP_CURRENCY=PKR
APP_LOCALE=en-PK
COMPANY_NAME=Abrar Medical Store

# GEMINI_API_KEY: Optional Gemini AI API key (injected at runtime via Secrets panel)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
